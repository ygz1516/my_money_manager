#:kivy 2.0

<DepositItem>:
    orientation: 'horizontal'
    size_hint_y: None
    height: dp(50)
    canvas.before:
        Color:
            rgba: (0.95, 0.95, 0.95, 1)
        Rectangle:
            pos: self.pos
            size: self.size
    Label:
        text: root.bank
        size_hint_x: 0.2
    Label:
        text: root.deposit_type
        size_hint_x: 0.15
    Label:
        text: root.holder
        size_hint_x: 0.15
    Label:
        text: root.amount
        size_hint_x: 0.2
    Label:
        text: root.maturity_date
        size_hint_x: 0.15
    Label:
        text: root.current_interest
        size_hint_x: 0.15

<DepositListView>:
    viewclass: 'DepositItem'
    ScrollView:
        id: scroll
        GridLayout:
            id: deposit_container
            cols: 1
            size_hint_y: None
            height: self.minimum_height
            spacing: dp(2)

<MainScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: dp(10)
        spacing: dp(5)
        BoxLayout:
            size_hint_y: None
            height: dp(50)
            spacing: dp(5)
            Spinner:
                id: user_spinner
                text: root.current_user_text
                values: root.user_list
                on_text: root.change_user(self.text)
            Button:
                text: '添加'
                on_release: root.show_add_dialog()
            Button:
                text: '统计'
                on_release: root.show_stats()
            Button:
                text: '到期提醒'
                on_release: root.check_maturities()
        BoxLayout:
            size_hint_y: None
            height: dp(50)
            spacing: dp(5)
            TextInput:
                id: search_input
                hint_text: '搜索银行/类型/备注...'
                on_text: root.search_filter(self.text)
            Button:
                text: '备份'
                on_release: root.backup_data()
            Button:
                text: '恢复'
                on_release: root.restore_data()
        DepositListView:
            id: deposit_list
        Label:
            id: status_label
            size_hint_y: None
            height: dp(40)
            text: ''
